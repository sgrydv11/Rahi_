                ]
              }
            }
          ]
        },
        {
          "name": "13 — Arbitrary driver ID is rejected",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"{{origin}}\",\n  \"destination\": \"{{destination}}\",\n  \"departureAt\": \"{{departureAt}}\",\n  \"timeZone\": \"Asia/Kolkata\",\n  \"totalSeats\": 3,\n  \"pricePerSeat\": 125.5,\n  \"currency\": \"INR\",\n  \"pickupDescription\": \"Station entrance\",\n  \"dropoffDescription\": \"City centre\",\n  \"vehicleDetails\": \"Blue hatchback\",\n  \"notes\": \"Generated Phase 3 API test offer\",\n  \"driverId\": \"00000000-0000-0000-0000-000000000001\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "14 — Cancel owned ride",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{rideVersion}},\n  \"reason\": \"API test completed\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code < 300) { const data = pm.response.json(); pm.collectionVariables.set(\"rideVersion\", String(data.version)); }",
                  "pm.test(\"Cancelled history is retained\", function () { const data = pm.response.json(); pm.expect(data.status).to.eql(\"CANCELLED\"); pm.expect(typeof data.cancelledAt === \"string\").to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "15 — Cancelled ride leaves search",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides?origin={{origin}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"No cancelled offer returned\", function () { pm.expect(pm.response.json().totalElements).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "16 — Cancelled ride cannot be edited",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"version\": {{rideVersion}},\n  \"notes\": \"Should not change\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "17 — Health remains public",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/actuator/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "18 — Logout and clear test credentials",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              }
            ],
            "url": "{{serverUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "[\"csrfToken\", \"testPassword\", \"accessToken\", \"refreshToken\", \"beforeRotationToken\", \"loggedOutRefreshToken\"].forEach(k => pm.collectionVariables.set(k, \"\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
