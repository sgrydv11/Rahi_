                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"Structured error without credentials\", function () {",
                  "  const data = pm.response.json();",
                  "  pm.expect(data.status === pm.response.code).to.eql(true);",
                  "  pm.expect(typeof data.detail === \"string\").to.eql(true);",
                  "  pm.expect(!Object.prototype.hasOwnProperty.call(data, \"password\")).to.eql(true);",
                  "  pm.expect(!Object.prototype.hasOwnProperty.call(data, \"accessToken\")).to.eql(true);",
