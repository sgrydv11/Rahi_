{
  "info": {
    "name": "Hoopr — Phase 2 Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run all folders once, in order, against a local/test Hoopr backend. Creates two test accounts per run. Explicit Cookie headers and disabled cookie jars keep replay scenarios deterministic. Runtime tokens/passwords use collection variables: do not export their populated values. See docs/api/README.md. Health needs no auth; auth POSTs require trusted Origin plus matching CSRF cookie/header."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "serverUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173",
      "type": "string"
    },
    {
      "key": "expectedCookieSecure",
      "value": "false",
      "type": "string"
    },
    {
      "key": "expectedSameSite",
      "value": "Lax",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "upperEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "beforeRotationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "loggedOutRefreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 — Happy path (run first)",
      "item": [
        {
          "name": "01 — API health (public)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/health",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Health is UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Actuator health (public)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/actuator/health",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Health is UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Initialize test account and get CSRF",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/csrf",
            "description": "Expected HTTP 200. Run this once before the remaining requests. It generates a new email/password and resets token variables. Does not register yet."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only generated throwaway credentials; never use a real account for this run.",
                  "const id = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"testEmail\", \"hoopr-api-\" + id + \"@example.test\");",
                  "pm.collectionVariables.set(\"upperEmail\", pm.collectionVariables.get(\"testEmail\").toUpperCase());",
                  "pm.collectionVariables.set(\"testPassword\", \"Hoopr-test-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"csrfToken\", \"userId\", \"accessToken\", \"refreshToken\", \"beforeRotationToken\", \"loggedOutRefreshToken\"].forEach(k => pm.collectionVariables.set(k, \"\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"CSRF token and expected header returned\", function () {",
                  "    pm.expect(typeof data.token === \"string\" && data.token.length > 0).to.eql(true);",
                  "    pm.expect(data.headerName).to.eql(\"X-XSRF-TOKEN\");",
                  "  });",
                  "  pm.collectionVariables.set(\"csrfToken\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — Register USER",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/register",
            "description": "Expected HTTP 201. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Hoopr API Test\",\n  \"travelPreference\": \"BOTH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.test(\"Registration creates USER without password fields\", function () {",
                  "  pm.expect(data.role).to.eql(\"USER\");",
                  "  pm.expect(data.travelPreference).to.eql(\"BOTH\");",
                  "  pm.expect(data.email === pm.collectionVariables.get(\"testEmail\")).to.eql(true);",
                  "  pm.expect(!(\"password\" in data) && !(\"passwordHash\" in data)).to.eql(true);",
                  "}); pm.collectionVariables.set(\"userId\", data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — Login and capture tokens",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/login",
            "description": "Expected HTTP 200. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\");",
                  "  const refresh = cookies.map(h => /^hoopr_refresh=([^;]*)/.exec(h.value)).find(Boolean);",
                  "  pm.test(\"Access token lasts 15 minutes; refresh stays out of JSON\", function () {",
                  "    pm.expect(typeof data.accessToken === \"string\" && data.accessToken.length > 0).to.eql(true);",
                  "    pm.expect(data.expiresIn).to.eql(900); pm.expect(data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(!Object.prototype.hasOwnProperty.call(data, \"refreshToken\")).to.eql(true);",
                  "  });",
                  "  pm.test(\"Refresh cookie attributes match configured expectations\", function () {",
                  "    pm.expect(Boolean(refresh)).to.eql(true);",
                  "    const header = cookies.find(h => h.value.startsWith(\"hoopr_refresh=\")).value;",
                  "    pm.expect(/;\\s*HttpOnly(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Path=\\/api\\/v1\\/auth(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Secure(?:;|$)/i.test(header)).to.eql(pm.variables.get(\"expectedCookieSecure\") === \"true\");",
                  "    pm.expect(header.includes(\"SameSite=\" + pm.variables.get(\"expectedSameSite\"))).to.eql(true);",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "  });",
                  "  if (refresh) pm.collectionVariables.set(\"refreshToken\", refresh[1]);",
                  "  pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — My profile (Bearer)",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/users/me",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Profile belongs to the registered USER\", function () { const data = pm.response.json();",
                  "pm.expect(data.id === pm.collectionVariables.get(\"userId\")).to.eql(true); pm.expect(data.role).to.eql(\"USER\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 — Rotate refresh token",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/refresh",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"beforeRotationToken\", pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\");",
                  "  const refresh = cookies.map(h => /^hoopr_refresh=([^;]*)/.exec(h.value)).find(Boolean);",
                  "  pm.test(\"Access token lasts 15 minutes; refresh stays out of JSON\", function () {",
                  "    pm.expect(typeof data.accessToken === \"string\" && data.accessToken.length > 0).to.eql(true);",
                  "    pm.expect(data.expiresIn).to.eql(900); pm.expect(data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(!Object.prototype.hasOwnProperty.call(data, \"refreshToken\")).to.eql(true);",
                  "  });",
                  "  pm.test(\"Refresh cookie attributes match configured expectations\", function () {",
                  "    pm.expect(Boolean(refresh)).to.eql(true);",
                  "    const header = cookies.find(h => h.value.startsWith(\"hoopr_refresh=\")).value;",
                  "    pm.expect(/;\\s*HttpOnly(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Path=\\/api\\/v1\\/auth(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Secure(?:;|$)/i.test(header)).to.eql(pm.variables.get(\"expectedCookieSecure\") === \"true\");",
                  "    pm.expect(header.includes(\"SameSite=\" + pm.variables.get(\"expectedSameSite\"))).to.eql(true);",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "  });",
                  "  if (refresh) pm.collectionVariables.set(\"refreshToken\", refresh[1]);",
                  "  pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "}",
                  "if (pm.response.code === 200) pm.test(\"Refresh token rotated\", function () {",
                  "pm.expect(pm.collectionVariables.get(\"refreshToken\") !== pm.collectionVariables.get(\"beforeRotationToken\")).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "08 — My profile with refreshed access token",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/users/me",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
