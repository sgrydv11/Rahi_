    {
      "name": "2 — Lifecycle after departure",
      "item": [
        {
          "name": "start ride",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}/start",
            "body": {
              "mode": "raw",
              "raw": "{\"version\":{{rideVersion}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State and timestamp\", function () { const ride = pm.response.json(); pm.expect(ride.status).to.eql(\"IN_PROGRESS\"); pm.expect(Boolean(ride.startedAt)).to.eql(true); });",
                  "pm.collectionVariables.set(\"rideVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Passenger sees IN_PROGRESS",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{serverUrl}}/api/v1/bookings/{{bookingId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Trip and reservation states\", function () { const b = pm.response.json(); pm.expect(b.ride.status).to.eql(\"IN_PROGRESS\"); pm.expect(b.status).to.eql(\"CONFIRMED\"); pm.expect(b.canCancel).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "complete ride",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{ownerAccessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}/complete",
            "body": {
              "mode": "raw",
              "raw": "{\"version\":{{rideVersion}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"State and timestamp\", function () { const ride = pm.response.json(); pm.expect(ride.status).to.eql(\"COMPLETED\"); pm.expect(Boolean(ride.completedAt)).to.eql(true); });",
                  "pm.collectionVariables.set(\"rideVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Passenger sees COMPLETED",
