              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Trip and reservation states\", function () { const b = pm.response.json(); pm.expect(b.ride.status).to.eql(\"COMPLETED\"); pm.expect(b.status).to.eql(\"CONFIRMED\"); pm.expect(b.canCancel).to.eql(false); });"
