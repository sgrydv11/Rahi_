        {
          "name": "25 — Logout passenger",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              }
            ],
            "url": "{{serverUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        },
        {
          "name": "26 — Logout driver and clear generated credentials",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
