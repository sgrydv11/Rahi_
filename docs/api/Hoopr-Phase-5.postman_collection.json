{
  "info": {
    "name": "Hoopr — Phase 5 Ride Lifecycle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run Setup before departure, then run Lifecycle after departure. Use a disposable local environment."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "serverUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "frontendOrigin",
      "value": "http://localhost:5173",
      "type": "string"
    },
    {
      "key": "expectedCookieSecure",
      "value": "false",
      "type": "string"
    },
    {
      "key": "expectedSameSite",
      "value": "Lax",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "testEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "upperEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "testPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "beforeRotationToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "loggedOutRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "rideId",
      "value": "",
      "type": "string"
    },
    {
      "key": "initialRideVersion",
      "value": "",
      "type": "string"
    },
    {
      "key": "rideVersion",
      "value": "",
      "type": "string"
    },
    {
      "key": "departureAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "origin",
      "value": "",
      "type": "string"
    },
    {
      "key": "destination",
      "value": "",
      "type": "string"
    },
    {
      "key": "passengerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerAccessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "ownerRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondBookingKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 — Setup before departure",
      "item": [
        {
          "name": "01 — Public health",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/health",
            "description": "Expected HTTP 200. "
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Health is UP\", function () { pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "02 — Initialize credentials and CSRF",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/csrf",
            "description": "Expected HTTP 200. Run this once before the remaining requests. It generates a new email/password and resets token variables. Does not register yet."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only generated throwaway credentials; never use a real account for this run.",
                  "const id = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"testEmail\", \"hoopr-api-\" + id + \"@example.test\");",
                  "pm.collectionVariables.set(\"upperEmail\", pm.collectionVariables.get(\"testEmail\").toUpperCase());",
                  "pm.collectionVariables.set(\"testPassword\", \"Hoopr-test-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"csrfToken\", \"userId\", \"accessToken\", \"refreshToken\", \"beforeRotationToken\", \"loggedOutRefreshToken\"].forEach(k => pm.collectionVariables.set(k, \"\"));",
                  "pm.collectionVariables.set(\"departureAt\", new Date(Date.now() + 120000).toISOString());",
                  "pm.collectionVariables.set(\"origin\", \"HooprOrigin-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"destination\", \"HooprDestination-\" + pm.variables.replaceIn(\"{{$guid}}\"));",
                  "[\"rideId\", \"rideVersion\", \"initialRideVersion\"].forEach(k => pm.collectionVariables.set(k, \"\"));",
                  "pm.collectionVariables.set(\"passengerEmail\", \"hoopr-booking-\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.test\");",
                  "pm.collectionVariables.set(\"bookingKey\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.collectionVariables.set(\"secondBookingKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test(\"CSRF token and expected header returned\", function () {",
                  "    pm.expect(typeof data.token === \"string\" && data.token.length > 0).to.eql(true);",
                  "    pm.expect(data.headerName).to.eql(\"X-XSRF-TOKEN\");",
                  "  });",
                  "  pm.collectionVariables.set(\"csrfToken\", data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 — Register test driver",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/register",
            "description": "Expected HTTP 201. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Hoopr API Test\",\n  \"travelPreference\": \"BOTH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.test(\"Registration creates USER without password fields\", function () {",
                  "  pm.expect(data.role).to.eql(\"USER\");",
                  "  pm.expect(data.travelPreference).to.eql(\"BOTH\");",
                  "  pm.expect(data.email === pm.collectionVariables.get(\"testEmail\")).to.eql(true);",
                  "  pm.expect(!(\"password\" in data) && !(\"passwordHash\" in data)).to.eql(true);",
                  "}); pm.collectionVariables.set(\"userId\", data.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "04 — Login",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/login",
            "description": "Expected HTTP 200. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\");",
                  "  const refresh = cookies.map(h => /^hoopr_refresh=([^;]*)/.exec(h.value)).find(Boolean);",
                  "  pm.test(\"Access token lasts 15 minutes; refresh stays out of JSON\", function () {",
                  "    pm.expect(typeof data.accessToken === \"string\" && data.accessToken.length > 0).to.eql(true);",
                  "    pm.expect(data.expiresIn).to.eql(900); pm.expect(data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(!Object.prototype.hasOwnProperty.call(data, \"refreshToken\")).to.eql(true);",
                  "  });",
                  "  pm.test(\"Refresh cookie attributes match configured expectations\", function () {",
                  "    pm.expect(Boolean(refresh)).to.eql(true);",
                  "    const header = cookies.find(h => h.value.startsWith(\"hoopr_refresh=\")).value;",
                  "    pm.expect(/;\\s*HttpOnly(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Path=\\/api\\/v1\\/auth(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Secure(?:;|$)/i.test(header)).to.eql(pm.variables.get(\"expectedCookieSecure\") === \"true\");",
                  "    pm.expect(header.includes(\"SameSite=\" + pm.variables.get(\"expectedSameSite\"))).to.eql(true);",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "  });",
                  "  if (refresh) pm.collectionVariables.set(\"refreshToken\", refresh[1]);",
                  "  pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "}",
                  "pm.collectionVariables.set(\"ownerAccessToken\", pm.collectionVariables.get(\"accessToken\"));",
                  "pm.collectionVariables.set(\"ownerRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 — Create a scheduled ride",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"{{origin}}\",\n  \"destination\": \"{{destination}}\",\n  \"departureAt\": \"{{departureAt}}\",\n  \"timeZone\": \"Asia/Kolkata\",\n  \"totalSeats\": 3,\n  \"pricePerSeat\": 125.5,\n  \"currency\": \"INR\",\n  \"pickupDescription\": \"Station entrance\",\n  \"dropoffDescription\": \"City centre\",\n  \"vehicleDetails\": \"Blue hatchback\",\n  \"notes\": \"Generated Phase 3 API test offer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "if (pm.response.code === 201) { const data = pm.response.json();",
                  "pm.collectionVariables.set(\"rideId\", data.id); pm.collectionVariables.set(\"initialRideVersion\", String(data.version));",
                  "pm.collectionVariables.set(\"rideVersion\", String(data.version));",
                  "pm.test(\"Ride belongs to JWT user and starts with all seats\", function () { pm.expect(data.driver.id === pm.collectionVariables.get(\"userId\")).to.eql(true); pm.expect(data.availableSeats).to.eql(3); pm.expect(data.status).to.eql(\"SCHEDULED\"); }); }"
                ]
              }
            }
          ]
        },
        {
          "name": "06 — Register test passenger",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/register",
            "description": "Expected HTTP 201. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{passengerEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"fullName\": \"Passenger PrivateSurname\",\n  \"travelPreference\": \"BOTH\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "07 — Login as passenger",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{frontendOrigin}}"
              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{refreshToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{serverUrl}}/api/v1/auth/login",
            "description": "Expected HTTP 200. ",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{passengerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  const cookies = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\");",
                  "  const refresh = cookies.map(h => /^hoopr_refresh=([^;]*)/.exec(h.value)).find(Boolean);",
                  "  pm.test(\"Access token lasts 15 minutes; refresh stays out of JSON\", function () {",
                  "    pm.expect(typeof data.accessToken === \"string\" && data.accessToken.length > 0).to.eql(true);",
                  "    pm.expect(data.expiresIn).to.eql(900); pm.expect(data.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(!Object.prototype.hasOwnProperty.call(data, \"refreshToken\")).to.eql(true);",
                  "  });",
                  "  pm.test(\"Refresh cookie attributes match configured expectations\", function () {",
                  "    pm.expect(Boolean(refresh)).to.eql(true);",
                  "    const header = cookies.find(h => h.value.startsWith(\"hoopr_refresh=\")).value;",
                  "    pm.expect(/;\\s*HttpOnly(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Path=\\/api\\/v1\\/auth(?:;|$)/i.test(header)).to.eql(true);",
                  "    pm.expect(/;\\s*Secure(?:;|$)/i.test(header)).to.eql(pm.variables.get(\"expectedCookieSecure\") === \"true\");",
                  "    pm.expect(header.includes(\"SameSite=\" + pm.variables.get(\"expectedSameSite\"))).to.eql(true);",
                  "    pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "  });",
                  "  if (refresh) pm.collectionVariables.set(\"refreshToken\", refresh[1]);",
                  "  pm.collectionVariables.set(\"accessToken\", data.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "09 — Book two seats",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{bookingKey}}"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}/bookings",
            "body": {
              "mode": "raw",
              "raw": "{\"seats\":2}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"bookingId\", pm.response.json().id);",
                  "pm.test(\"Server price snapshot and private passenger\", function () { const b=pm.response.json(); pm.expect(b.seats).to.eql(2); pm.expect(Number(b.totalPrice)).to.eql(Number(b.pricePerSeat)*2); pm.expect(b.passenger.displayName).to.eql(\"Passenger\"); pm.expect(\"email\" in b.passenger).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "21 — Load latest ride version",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{serverUrl}}/api/v1/rides/{{rideId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"rideVersion\", pm.response.json().version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject passenger start",
          "protocolProfileBehavior": {
            "disableCookies": true
          },
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
