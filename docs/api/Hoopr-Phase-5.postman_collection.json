              },
              {
                "key": "X-XSRF-TOKEN",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Cookie",
                "value": "XSRF-TOKEN={{csrfToken}}; hoopr_refresh={{ownerRefreshToken}}"
              }
            ],
            "url": "{{serverUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "[\"testEmail\",\"passengerEmail\",\"testPassword\",\"csrfToken\",\"accessToken\",\"refreshToken\",\"ownerAccessToken\",\"ownerRefreshToken\"].forEach(k => pm.collectionVariables.set(k,\"\"));"
                ]
              }
            }
          ]
        }
      ]
    }
